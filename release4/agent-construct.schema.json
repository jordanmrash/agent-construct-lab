{
  "$schema": "https://<scrubbed-url-domain>/draft/2020-12/schema",
  "$id": "acl:agent-construct:1",
  "title": "Agent Construct Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "purpose", "capabilities", "components", "governance", "memory", "evaluation", "targets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 3 },
    "purpose": { "type": "string", "minLength": 10 },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_policy", "prohibited_actions", "evidence_required", "rollback_required"],
      "properties": {
        "approval_policy": { "enum": ["read-only", "explicit-for-state-change", "explicit-per-action"] },
        "prohibited_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "evidence_required": { "type": "boolean" },
        "rollback_required": { "type": "boolean" }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["durable", "incident_learning", "promotion_requires_review"],
      "properties": {
        "durable": { "type": "boolean" },
        "incident_learning": { "type": "boolean" },
        "promotion_requires_review": { "type": "boolean" }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_suite", "minimum_score"],
      "properties": {
        "shared_suite": { "type": "string", "minLength": 1 },
        "minimum_score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["microsoft-365", "claude", "chatgpt", "gemini", "open-runtime"] } }
  }
}
