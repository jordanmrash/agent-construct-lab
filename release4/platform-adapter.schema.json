{
  "$schema": "https://<scrubbed-url-domain>/draft/2020-12/schema",
  "$id": "acl:platform-adapter:1",
  "title": "Agent Construct Lab Platform Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target", "input_contract", "outputs", "tool_mapping", "host_specific", "validation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "target": { "enum": ["microsoft-365", "claude", "chatgpt", "gemini", "open-runtime"] },
    "input_contract": { "const": "acl:agent-construct:1" },
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "tool_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["filesystem", "command", "browser"],
      "properties": {
        "filesystem": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 }
      }
    },
    "host_specific": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["shared_required", "adapter_required", "publish_requires_approval"],
      "properties": {
        "shared_required": { "type": "boolean", "const": true },
        "adapter_required": { "type": "boolean", "const": true },
        "publish_requires_approval": { "type": "boolean", "const": true }
      }
    }
  }
}
